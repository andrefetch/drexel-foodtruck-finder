# Copy to .env and fill in. .env is gitignored; set these in Vercel for deploys.

# CARTO Basemaps API key. Without it the raster map tiles render watermarked.
# Get one at https://carto.com/basemaps/apikey
CARTO_API_KEY=

# Flask session signing key. Use a long random value in production.
SECRET_KEY=

# SQLAlchemy connection string. Defaults to sqlite:///site.db when unset.
DATABASE_URL=
